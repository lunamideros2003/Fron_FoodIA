# Base URL of the FoodMood IA API.
# Leave it empty to use the Vite dev proxy (recommended for local development):
# requests to /api/* are forwarded to http://localhost:4000.
VITE_API_BASE_URL=

# Used by the Vite dev-server proxy. Only needed if the backend runs elsewhere.
VITE_API_PROXY=http://localhost:4000
